# Application Environment Configuration
PORT=3000
NODE_ENV=development

# Backend SQLite and Artifact Storage Paths
EMG_DB_PATH=./data/emg_intelligence.db
EMG_UPLOAD_DIR=./data/uploads
EMG_MODEL_DIR=./data/models

# Optional: Point frontend to standalone Python FastAPI server (default: same-origin /api)
VITE_API_BASE_URL=/api

# FastAPI Standalone Server Configuration (see /backend/README.md)
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
